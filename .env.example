# LUKE'S Design Studio — Free-tier upload -> RFQ funnel
# Values are read only by Vercel serverless functions. Never commit real secrets.

# REQUIRED: connect a Vercel Blob store configured for PRIVATE access.
# The upload and RFQ endpoints now request access: 'private'; a public-only
# store is not an acceptable fallback. No customer files or RFQ metadata may
# be written to public Blob storage.
BLOB_READ_WRITE_TOKEN=

# OPTIONAL owner ping. Webhook payload contains only the RFQ ID, space and
# file count — never contact details, notes, or media URLs.
RFQ_NOTIFY_WEBHOOK=

# OPTIONAL defense-in-depth AES-256-GCM encryption for private RFQ JSON.
# If set, it must decode to exactly 32 bytes; invalid values fail closed.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LDS_DATA_KEY=

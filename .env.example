# LUKE'S Design Studio — Free-tier upload -> RFQ funnel
# These are read by the Vercel serverless functions in /api.

# REQUIRED to actually store uploads + RFQs. Connect a Vercel Blob store to the
# project (Vercel dashboard -> Storage -> Blob) and Vercel sets this for you.
# Without it, the upload page shows a clear "not configured yet" message.
BLOB_READ_WRITE_TOKEN=

# OPTIONAL. Owner notification: each new RFQ is POSTed as JSON to this URL
# (a Slack Incoming Webhook, Zapier/Make catch hook, or your own endpoint).
# Leave blank to only log to the function logs.
RFQ_NOTIFY_WEBHOOK=

# OPTIONAL but recommended. 32-byte base64 key; when set, stored RFQ records are
# encrypted at rest (AES-256-GCM) so customer contact details aren't readable
# from the blob. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LDS_DATA_KEY=
